{
  "name": "sistema-alquiler-de-campos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check": "tsx src/reservas.check.ts",
    "check:ui": "tsx src/ui.check.ts",
    "check:borrador": "tsx src/borradorReserva.check.ts && tsx src/borradorReserva-app.check.ts",
    "check:components": "tsx src/componentization.check.ts",
    "check:scenarios": "tsx src/reservas.scenarios.check.ts",
    "check:horarios-media": "tsx src/horariosMediaHora.check.ts",
    "check:admin": "tsx src/admin.check.ts",
    "check:editar-admin": "tsx src/editarReservaAdmin.check.ts",
    "check:validacion": "tsx src/validacionCliente.check.ts",
    "check:tokens": "tsx src/tokensReserva.check.ts",
    "check:control-clientes": "tsx src/controlClientes.check.ts",
    "check:confiables": "tsx src/clientesConfiablesAdelanto.check.ts",
    "check:pago-preview": "tsx src/pagoAdelanto.check.ts",
    "check:pago-admin": "tsx src/pagosAdmin.check.ts",
    "check:supabase": "tsx src/supabase.check.ts",
    "check:balance": "tsx src/balanceMensual.check.ts",
    "check:estado": "tsx src/estadoReserva.check.ts",
    "check:pago": "tsx src/pagos.check.ts",
    "check:limpieza": "tsx src/limpiezaDatosPrueba.check.ts",
    "check:alarm": "tsx src/utils/alarmaTurno.check.ts",
    "check:eventos": "tsx src/eventos.check.ts",
    "check:balance-texto": "tsx src/exportarBalanceTexto.check.ts",
    "check:typescript": "tsx src/typescript.check.ts",
    "check:accion": "tsx src/accionUnica.check.ts",
    "check:simulacion": "tsx src/simulacionReservas.test.ts && tsx src/simulacionClienteReservas.check.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  }
}
